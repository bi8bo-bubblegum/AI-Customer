# 应用配置
APP_NAME=AI-Customer
DEBUG=False

# 数据库配置（docker-compose 中会自动覆盖）
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/ai_customer
CHECKPOINTER_DATABASE_URL=postgresql://postgres:changeme@db:5432/ai_customer

# JWT 配置（生产环境务必更换密钥！）
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# LLM 配置
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=deepseek-v4-flash
LLM_TEMPERATURE=0.3

# Embedding 配置
EMBEDDING_BASE_URL=your_embedding_url
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG 配置
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
